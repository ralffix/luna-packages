      "install_script": "cp neofetch-7.1.0/neofetch /usr/local/bin/neofetch && chmod +x /usr/local/bin/neofetch && sed -i 's|#!/usr/bin/env bash|#!/bin/sh|g' /usr/local/bin/neofetch",
